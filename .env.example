# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Full connection string (used by Drizzle / pg)
DATABASE_URL=postgres://user:password@localhost:5432/hrms

# Individual PG connection parts (used by drizzle-kit and some tooling)
PGDATABASE=hrms
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password

# ─── Session ──────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies.
# Generate with: openssl rand -hex 64
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Admin account ────────────────────────────────────────────────────────────
# Temporary password for the built-in `admin` account.
# Required on first boot (and when FORCE_ADMIN_PASSWORD_RESET=true).
# Must be strong: 12+ chars, upper+lower+number+symbol.
# The value is NEVER written to logs — it is delivered via an operator-only
# 0600 file in ONE_TIME_PASSWORD_DIR (default: .credentials/).
ADMIN_RESET_PASSWORD=

# Set to true to force the admin account to re-provision on next API boot.
FORCE_ADMIN_PASSWORD_RESET=false

# ─── Demo / seed passwords (development only) ─────────────────────────────────
# Set SEED_DEMO_PASSWORDS=true to seed the demo accounts with a known password.
# Ignored in production (REPLIT_DEPLOYMENT set or NODE_ENV=production).
SEED_DEMO_PASSWORDS=false
DEMO_PILOT_PASSWORD=

# ─── Object storage ───────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ─── OTP handoff directory ────────────────────────────────────────────────────
# Directory where one-time password files are written (mode 0600, operator only).
# Default: .credentials/
ONE_TIME_PASSWORD_DIR=.credentials/

# ─── Smoke / CI passwords (optional) ─────────────────────────────────────────
# Password used by the Playwright smoke suite. Falls back to ADMIN_RESET_PASSWORD.
SMOKE_ADMIN_PASSWORD=
