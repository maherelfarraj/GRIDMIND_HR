modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

# Pre-publish gate: run the full regression check (schema-drift tests,
# mobile tests, monorepo typecheck) before any artifact builds. A non-zero
# exit blocks the release; output names each failing suite.
[deployment.build]
args = ["bash", "scripts/regression.sh"]
# PUBLISH_BUILD tells regression.sh to skip the live-DB schema-drift test:
# publish builds run before the production DB schema is synced, so that
# test always fails there (REPLIT_DEPLOYMENT is not set during builds).
env = { "CI" = "true", "PUBLISH_BUILD" = "1" }

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "smoke"

[[workflows.workflow]]
name = "schema-drift"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck:libs && cd artifacts/api-server && npx vitest run src/__tests__/schema-drift.test.ts src/__tests__/openapi-drift.test.ts src/__tests__/codegen-drift.test.ts"

[[workflows.workflow]]
name = "mobile-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && npx vitest run"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/regression.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-smoke.sh"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]

[nix]
channel = "stable-25_05"
