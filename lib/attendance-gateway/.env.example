# GRIDMIND HR Attendance Gateway — site-local configuration
#
# Keep this file on the gateway host only. Never commit real secrets, device
# passwords, API tokens, or biometric material to the repository.

# Issued once from GridMind HR > Attendance Gateway. Treat both as secrets.
HR_API_URL=http://hr-core.local:8080/api
GATEWAY_ID=
GATEWAY_SECRET=
GATEWAY_QUEUE_KEY=
GATEWAY_ADMIN_TOKEN=

# The queue must reside on encrypted persistent local storage.
GATEWAY_QUEUE_DIR=/var/lib/gridmind-attendance-gateway/queue
GATEWAY_ADAPTER=SIMULATOR
POLL_INTERVAL_MS=60000
RECONCILE_INTERVAL_MS=900000
CLOCK_SKEW_WARN_MS=60000
CLOCK_SKEW_MAX_MS=300000

# Keep the operator/status endpoint local. Do not expose it to the internet.
PORT=9800
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_ALLOW_REMOTE_ADMIN=false

# Set the gateway host and every device/middleware server to the same approved
# IANA time zone and synchronize them with the site's approved NTP source.
TZ=Asia/Amman

# ── ZKTeco through ZKBioTime / BioTime ──────────────────────────────────────
# GATEWAY_ADAPTER=ZKTECO
# ZKTECO_API_URL=http://zkbiotime.local:8000
# ZKTECO_USERNAME=gridmind_gateway
# ZKTECO_PASSWORD=

# ── Legacy ZKTeco standalone terminal ───────────────────────────────────────
# GATEWAY_ADAPTER=ZKTECO_NATIVE
# ZKTECO_DEVICE_HOST=10.20.30.40
# ZKTECO_DEVICE_PORT=4370
# ZKTECO_COMM_KEY=
# ZKTECO_TIMEOUT_MS=5000

# ── Suprema through BioStar 2 ───────────────────────────────────────────────
# GATEWAY_ADAPTER=SUPREMA
# SUPREMA_API_URL=https://biostar2.local
# SUPREMA_LOGIN_ID=gridmind_gateway
# SUPREMA_PASSWORD=

# ── Suprema native SDK adapter ──────────────────────────────────────────────
# Requires a licensed, vendor-supported SDK binding installed on this host.
# GATEWAY_ADAPTER=SUPREMA_NATIVE
# SUPREMA_DEVICE_HOST=10.20.30.50
# SUPREMA_DEVICE_PORT=51211
# SUPREMA_ADMIN_LOGIN_ID=gridmind_gateway
# SUPREMA_ADMIN_PASSWORD=
# SUPREMA_CERT_PATH=/etc/gridmind/certs/suprema-ca.pem
# SUPREMA_SDK_MODULE=<vendor-supported-binding-name>

# ── Generic REST middleware ─────────────────────────────────────────────────
# Required endpoint contract:
#   GET /health
#   GET /punches?since=<opaque cursor>
# GATEWAY_ADAPTER=GENERIC_REST
# DEVICE_API_URL=https://attendance-middleware.local
# DEVICE_API_KEY=

# ── Fully offline manual import ─────────────────────────────────────────────
# GATEWAY_ADAPTER=CSV
# Upload through the authenticated, loopback-only gateway operator API.
